node_modules/
dist/
# The exported browser weights, written by tools/export-web-model.js.
# 🔴 ANCHORED. Written as `model/` this matched ANY directory of that name at
# any depth, so it silently swallowed src/model/ - monomer.js and query-only.js
# were never committed, and the deployed site 404'd on both while every local
# checkout worked. A leading slash keeps it to the one at the root.
/model/
# The self-contained offline page, written by tools/bundle.py.
localfold-local.html
coverage/
artifacts/
test-results/
playwright-report/
*.log
.DS_Store
# Full-model captures are local development assets. The publish branch retains
# only a small subset needed by the default unit tests.
test/fixtures/evoformer/

# Benchmark and diagnostic pages written during optimisation work.
.scratch/
# The float32 master the quantiser reads; /model/ above is its int8 output.
/model.f32-backup/

# Written whenever tools/build_site.py imports a sibling.
__pycache__/

# The multimer export, written by tools/export_multimer_model.py: the shipped
# int8 one, and the float32 one the oracle uses to separate the graph from the
# quantisation.
/model-multimer
/model-multimer-f32

# The toy oracle's dumped tensors, written by tools/oracle/dump_toy_multimer.py.
/toy-oracle.json
/toy-oracle-3copies.json
/toy-oracle-monomer.json
/toy-oracle-stages.json
/toy-oracle-truncated.json
/toy-oracle-truncated-monomer.json
/toy-oracle-truncated-opmlast.json
/toy-oracle-truncated-notmpl.json
/toy-template.json
/toy-triangle.json

# The AF3 trunk oracle's dumps, written by tools/oracle/dump_af3_trunk.py.
/af3-oracle*.json

# The AF3 trunk export, written by tools/export_af3_model.py: the float32 master
# and tools/quantize_model.py's int8 output.
/model-af3
/model-af3-f32

# The full AF3 export, including the diffusion and confidence heads.
/model-af3-full-f32
/model-af3-full
/model-af3-int5
