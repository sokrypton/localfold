node_modules/
dist/
# The exported browser weights, written by tools/export-web-model.js.
# 🔴 ANCHORED. Written as `model/` this matched ANY directory of that name at
# any depth, so it silently swallowed src/model/ - monomer.js and query-only.js
# were never committed, and the deployed site 404'd on both while every local
# checkout worked. A leading slash keeps it to the one at the root.
/model/
coverage/
artifacts/
test-results/
playwright-report/
*.log
.DS_Store
# Full-model captures are local development assets. The publish branch retains
# only a small subset needed by the default unit tests.
test/fixtures/evoformer/

# Benchmark and diagnostic pages written during optimisation work.
.scratch/
# The float32 master the quantiser reads; /model/ above is its int8 output.
/model.f32-backup/

# Written whenever tools/build_site.py imports a sibling.
__pycache__/

# The multimer export, written by tools/export_multimer_model.py: the shipped
# int8 one, and the float32 one the oracle uses to separate the graph from the
# quantisation.
/model-multimer
/model-multimer-f32

# Every oracle dump, from every dump script, in one directory.
# 🔴 THEY USED TO SIT IN THE REPOSITORY ROOT, one ignore rule per file, and the
# list went stale every time a dump script learned a new output. 300 MB of
# generated tensors beside index.html also reads as repository content, which
# is the part that matters: a reader cannot tell what is the project and what
# is somebody's afternoon. One directory, one rule, and the checkers fetch from
# it by path.
/oracle-dumps/

# The AF3 trunk export, written by tools/export_af3_model.py: the float32 master
# and tools/quantize_model.py's int8 output.
/model-af3
/model-af3-f32

# The full AF3 export, including the diffusion and confidence heads.
/model-af3-full-f32
/model-af3-full
/model-af3-int5
# ...and the same pair for OpenBind, OpenFold3's v0.5.0 release, written by
# the same two tools with --model openbind.
/model-openbind0-full-f32
/model-openbind0-int5
# OpenDDE's exports, in the four shapes the port produces. The bundle is
# hosted (see MODEL_BUNDLES.opendde); the checkout keeps none of it.
/model-opendde-full-f32
/model-opendde-int5
/model-opendde-trunk-f32
/model-opendde-trunk-int5

# A saved copy of Google's AlphaFold Server page, kept locally as a reference
# for the entity interface. Not ours to redistribute, and not repo content.
server_suff/
server_stuff/
natives

# The AF2 distogram/pLDDT training set, written by
# tools/gpu/probe-af2-dgram-plddt.js: 108 single-sequence targets over four
# recycles, ~250 MB. Collected once and kept; see HANDOFF.md.
/plddt-data/

# ESM-C and ESMFold2, downloaded from Hugging Face by tools/esmc/fetch.py.
# The tower alone is 2.3 GB of float32 and the point of the work in tools/esmc/
# is to find out how much smaller it can be; neither belongs in the repository.
/esmc-600m/
/esmc-300m/
/esmfold2-fast-600m/
/esmfold2-fast-300m/
# ...and the 6B fold half, downloaded to read its architecture.
/esmfold2-fast-6b/
/model-esmc-*/
# ...and EF2-fast's own bundles, both sizes.
/model-ef2-fast-*/
/model-esmc-600m-f32
/model-esmc-600m-int5

# transformers, installed with --system-site-packages so it shares this
# machine's torch, purely to have an ORACLE for the hand-written ESM-C forward
# in tools/esmc/esmc_forward.py. Nothing shipped imports it.
/.venv-esm/
/model-esmfold2-*/
/model-esmfold2-trunk-f32
/esmfold2-fold.pdb

# 🔴 HELD BACK UNTIL THEY ARE FIXED AND CHECKED, not deleted. Both pages were
# built against a model row that has moved under them; they stay on disk while
# that is sorted out, and tools/build_site.py and tools/mobile-layout.py skip a
# page they cannot find rather than failing on it.
/single.html
/proteinhunter.html
