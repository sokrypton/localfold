# Metal kernels and helpers added to cuda/af3/src/fusedtriangle.cuh (CUDA syntax, translated with it), after its includes
@@@ insert
// out[h][row] = (LN(x[row]) W)[h] - fusedtriangle.cuh's lnHeadsK (tensor cores, 49 KB of shared memory) on Apple's
// 8x8 simdgroup matrices: a simdgroup LayerNorms 8 rows (as lnRowsToShared computes it: eps 1e-5, rounded to half as it
// stages it) into threadgroup memory, multiplies them by W (staged once a block) into an 8 x N tile, and the block writes
// a chunk's 64 rows of each head out together. One simdgroup a row with N dot products a lane held ~90 registers and
// ran at a fifth of its bandwidth (1.74 ms a call at 255 tokens) however its sums were reduced. N a multiple of 8.
template <int C, int N, class PT>
__global__ void lnHeadsMetal(const float* x, const float* lnScale, const float* lnOffset, const half* Wp, float* out,
                             size_t rows) {
  constexpr int K = C / 32, RW = 8, NW = 8, CH = RW * NW, XP = C + 8;
  threadgroup half Ws[C * N];
  threadgroup half Xs[NW * RW * XP];
  threadgroup float T[N * CH];
  const int lane = threadIdx.x & 31, warp = threadIdx.x / 32;
  for (int e = threadIdx.x; e < C * N; e += blockDim.x) Ws[e] = Wp[e];
  float sc[K], of[K];
  for (int k = 0; k < K; ++k) { sc[k] = lnScale[lane + 32 * k]; of[k] = lnOffset[lane + 32 * k]; }
  for (size_t chunk0 = (size_t)blockIdx.x * CH; chunk0 < rows; chunk0 += (size_t)gridDim.x * CH) {
    __syncthreads();
    threadgroup half* xw = Xs + warp * RW * XP;
    for (int r = 0; r < RW; ++r) {
      const size_t row = chunk0 + warp * RW + r;
      if (row >= rows) { for (int k = 0; k < K; ++k) xw[r * XP + lane + 32 * k] = (half)0; continue; }
      float v[K];
      float s = 0.f;
      for (int k = 0; k < K; ++k) { v[k] = (float)reinterpret_cast<const PT*>(x)[row * C + lane + 32 * k]; s += v[k]; }
      for (int o = 16; o; o >>= 1) s += __shfl_xor_sync(~0u, s, o);
      float mean = s / C, q = 0.f;
      for (int k = 0; k < K; ++k) { float d = v[k] - mean; q += d * d; }
      for (int o = 16; o; o >>= 1) q += __shfl_xor_sync(~0u, q, o);
      float inv = rsqrtf(q / C + 1e-5f);
      for (int k = 0; k < K; ++k) xw[r * XP + lane + 32 * k] = __float2half((v[k] - mean) * inv * sc[k] + of[k]);
    }
    simdgroup_barrier(mem_flags::mem_threadgroup);
    simdgroup_float8x8 acc[N / 8];
    for (int hb = 0; hb < N / 8; ++hb) acc[hb] = simdgroup_float8x8(0);
    for (int k0 = 0; k0 < C; k0 += 8) {
      simdgroup_half8x8 xm;
      simdgroup_load(xm, xw + k0, XP);
      for (int hb = 0; hb < N / 8; ++hb) {
        simdgroup_half8x8 wm;
        simdgroup_load(wm, Ws + k0 * N + hb * 8, N);
        simdgroup_multiply_accumulate(acc[hb], xm, wm, acc[hb]);
      }
    }
    // [row][head] stored transposed: T[head][chunk row]
    for (int hb = 0; hb < N / 8; ++hb) simdgroup_store(acc[hb], T + hb * 8 * CH + warp * RW, CH, ulong2(0, 0), true);
    __syncthreads();
    for (int e = threadIdx.x; e < N * CH; e += blockDim.x) {
      const int h = e / CH, rl = e % CH;
      if (chunk0 + rl < rows) out[(size_t)h * rows + chunk0 + rl] = T[e];
    }
  }
}

@@@ end
