# Environment defaults for the Metal af3 port (set unless the caller set them): the CUDA port's own switches.
# The fused pair-track kernels (fusedtriangle.cuh, fused256.cuh, fusedtransition.cuh) are tensor-core code with
# no Metal version yet: the unfused path is the one a T4 takes when they do not fit.
LOCALFOLD_UNFUSED=grid,triangle,transition
