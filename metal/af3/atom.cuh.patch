# The diffusion transformer's transition (attention blocks' ffw): its first GEMM writes silu(a) b from its accumulators
# (lf::gemmSwiglu over the interleaved weight, as the trunk's transition takes it in pairtrack.cuh.patch), where the port
# writes the 2I-wide widening and runs swigluK over it. Not the up-gated form (boltz2's a -> b gate, 3I wide).
# LOCALFOLD_UNFUSED_SWIGLU=1 is the control.
@@@ old
  linear<T, T>(tn, wide, qRows, C, up ? 3 * I : 2 * I, w1);
  swiglu<T>(wide, gated, qRows, I, up);
@@@ new
  static const bool fuseSwiglu = !getenv("LOCALFOLD_UNFUSED_SWIGLU");
  bool fused = false;
  if constexpr (std::is_same_v<T, half>) if (fuseSwiglu && !up) {
    lf::gemmSwiglu(tn, swigluPairs(w1, C, I), gated, qRows, C, I);
    fused = true;
  }
  if (!fused) {
    linear<T, T>(tn, wide, qRows, C, up ? 3 * I : 2 * I, w1);
    swiglu<T>(wide, gated, qRows, I, up);
  }
@@@ end
