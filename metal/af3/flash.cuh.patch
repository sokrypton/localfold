# Metal kernels and helpers added to cuda/af3/src/flash.cuh (CUDA syntax, translated with it), after its includes
@@@ insert
// The grid attention on Apple's 8x8 simdgroup matrices - every form cuda/af3/src/flash.cuh's tensor-core kernels
// take (flashGridHalf, flashGrid2R, flashSplitHalf: dense or strided rows, a key mask or none, a pair bias or none),
// in one kernel, which metal/af3/host/flash*.h route them to.
//   q, k, v, gate at base + pos(i) + {0, W, 2W, 3W} (W = heads * D), base = qkvg + row * rowStride + head * D
//   logits = (q + qBias) * scale . k + bias[head][i][j] / log2(e) + (mask: 0 or -1e9 by the KEY's mask, row or transposed)
//   (the f16 path's pair bias is written already scaled by log2(e) - flashGridHalf's contract - and added as it is)
//   out[row * outRowStride + i * outPosStride + head * D + e] = softmax(logits) . v * sigmoid(gate)
// A threadgroup is 32 queries of one (row, head): four simdgroups of 8, keys 16 at a time through threadgroup
// memory (K transposed as it is staged, so S = Q K^T loads K^T straight), the softmax in registers in base 2
// (thread_elements: a lane holds two adjacent columns of a row, the row's four lanes differing in lane bits 0 and 3).
// The head is the slowest grid index, as in flashGridHalf: a head's bias stays hot across its rows.
template <int D, bool MASKED, bool NB>
__global__ void flashGridMetal(const half* qkvg, const half* bias, int biasStride, const float* mask, half* out, int n,
                               int heads, size_t r0, bool tr, float scale, const float* qBias, size_t rowStride,
                               size_t posStride, size_t outRowStride, size_t outPosStride, int rowsHere) {
  constexpr int BK = 16, QB = 32;
  threadgroup half Qs[QB * D];
  threadgroup half Ks[D * BK];      // [d][key]
  threadgroup half Vs[BK * D];      // [key][d]
  const int warp = _c.warp, lane = _c.lane, tid = threadIdx.x;
  const size_t b = blockIdx.y;
  const int h = (int)(b / rowsHere);
  const size_t rl = b % rowsHere, r = r0 + rl;
  const int Wd = heads * D;
  device const half* base = qkvg + rl * rowStride + h * D;
  const int i0 = blockIdx.x * QB;
  const float qs = scale * 1.4426950408889634f;
  for (int t = tid; t < QB * D; t += 128) {
    int qi = t / D, e = t % D, i = i0 + qi;
    float v = 0.f;
    if (i < n) { v = (float)base[(size_t)i * posStride + e]; if (qBias) v += qBias[h * D + e]; v *= qs; }
    Qs[t] = (half)v;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  simdgroup_half8x8 Qm[D / 8];
  simdgroup_float8x8 O[D / 8];
  _Pragma("clang loop unroll(full)")
  for (int dt = 0; dt < D / 8; ++dt) {
    simdgroup_load(Qm[dt], Qs + warp * 8 * D, D, ulong2(dt * 8, 0));
    O[dt] = simdgroup_float8x8(0);
  }
  const int sm = (lane / 16) * 4 + (lane % 8) / 2, sn = ((lane / 8) % 2) * 4 + (lane % 2) * 2;
  const int i = i0 + warp * 8 + sm;
  const int ib = i < n ? i : n - 1;
  device const half* brow = NB ? (device const half*)nullptr : bias + ((size_t)h * n + ib) * biasStride;
  float m = -INFINITY, l = 0.f;
  const bool vec4 = (rowStride % 4 == 0) && (posStride % 4 == 0) && (Wd % 4 == 0) && (D % 4 == 0);
  for (int j0 = 0; j0 < n; j0 += BK) {
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (vec4) {     // four halves a load (the strides are in fours): a quarter of the load instructions
      for (int t = tid * 4; t < BK * D; t += 128 * 4) {
        int jj = t / D, e = t % D, j = min(j0 + jj, n - 1);
        device const half* kp = base + (size_t)j * posStride;
        half4 kv = *(device const half4*)(kp + Wd + e);
        Ks[(e + 0) * BK + jj] = kv.x; Ks[(e + 1) * BK + jj] = kv.y;
        Ks[(e + 2) * BK + jj] = kv.z; Ks[(e + 3) * BK + jj] = kv.w;
        *(threadgroup half4*)(Vs + t) = *(device const half4*)(kp + 2 * Wd + e);
      }
    } else
    for (int t = tid; t < BK * D; t += 128) {
      int jj = t / D, e = t % D, j = min(j0 + jj, n - 1);
      device const half* kp = base + (size_t)j * posStride;
      Ks[e * BK + jj] = kp[Wd + e];
      Vs[t] = kp[2 * Wd + e];
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    simdgroup_float8x8 S[BK / 8];
    float tmax = -INFINITY;
    _Pragma("clang loop unroll(full)")
    for (int kt = 0; kt < BK / 8; ++kt) {
      S[kt] = simdgroup_float8x8(0);
      _Pragma("clang loop unroll(full)")
      for (int dt = 0; dt < D / 8; ++dt) {
        simdgroup_half8x8 Kt;
        simdgroup_load(Kt, Ks, BK, ulong2(kt * 8, dt * 8));
        simdgroup_multiply_accumulate(S[kt], Qm[dt], Kt, S[kt]);
      }
      thread auto& e = S[kt].thread_elements();
      _Pragma("clang loop unroll(full)")
      for (int t = 0; t < 2; ++t) {
        int j = j0 + kt * 8 + sn + t;
        float v;
        if (j < n) {
          v = e[t];
          if (!NB) v += (float)brow[j];       // (the producer writes the bias already times log2(e), as flashGridHalf takes it)
          if (MASKED && !(mask[tr ? ((size_t)j * n + r) : (r * n + j)] > 0.f)) v -= 1e9f * 1.4426950408889634f;
        } else {
          v = -INFINITY;
        }
        e[t] = v;
        tmax = fmax(tmax, v);
      }
    }
    tmax = fmax(tmax, simd_shuffle_xor(tmax, 1));
    tmax = fmax(tmax, simd_shuffle_xor(tmax, 8));
    const float nm = fmax(m, tmax);
    const float alpha = m == -INFINITY ? 0.f : exp2(m - nm);
    float sum = 0.f;
    simdgroup_half8x8 P[BK / 8];
    _Pragma("clang loop unroll(full)")
    for (int kt = 0; kt < BK / 8; ++kt) {
      thread auto& e = S[kt].thread_elements();
      float p0 = e[0] == -INFINITY ? 0.f : exp2(e[0] - nm), p1 = e[1] == -INFINITY ? 0.f : exp2(e[1] - nm);
      sum += p0 + p1;
      thread auto& pe = P[kt].thread_elements();
      pe[0] = (half)p0; pe[1] = (half)p1;
    }
    sum += simd_shuffle_xor(sum, 1);
    sum += simd_shuffle_xor(sum, 8);
    l = l * alpha + sum;
    m = nm;
    _Pragma("clang loop unroll(full)")
    for (int dt = 0; dt < D / 8; ++dt) {
      thread auto& oe = O[dt].thread_elements();
      oe[0] *= alpha; oe[1] *= alpha;
      _Pragma("clang loop unroll(full)")
      for (int kt = 0; kt < BK / 8; ++kt) {
        simdgroup_half8x8 Vm;
        simdgroup_load(Vm, Vs, D, ulong2(dt * 8, kt * 8));
        simdgroup_multiply_accumulate(O[dt], P[kt], Vm, O[dt]);
      }
    }
  }
  if (i >= n) return;
  const float inv = 1.f / l;
  device const half* gp = base + (size_t)i * posStride + 3 * Wd;
  device half* op = out + rl * outRowStride + (size_t)i * outPosStride + h * D;
  _Pragma("clang loop unroll(full)")
  for (int dt = 0; dt < D / 8; ++dt) {
    thread auto& oe = O[dt].thread_elements();
    int e = dt * 8 + sn;
    op[e] = (half)(oe[0] * inv * sigm((float)gp[e]));
    op[e + 1] = (half)(oe[1] * inv * sigm((float)gp[e + 1]));
  }
}
// every form, the dense layout's strides filled in where the caller gave none
template <int D>
inline void flashGridMetalRun(const half* qkvg, const half* bias, int biasStride, const float* mask, half* out, int n,
                              int heads, size_t r0, size_t rows, bool tr, float scale, const float* qBias,
                              size_t rowStride = 0, size_t posStride = 0, size_t outRowStride = 0, size_t outPosStride = 0) {
  const size_t W = (size_t)heads * D;
  if (!posStride) { rowStride = (size_t)n * 4 * W; posStride = 4 * W; outRowStride = (size_t)n * W; outPosStride = W; }
  dim3 grid((n + 31) / 32, (unsigned)(rows * heads));
  // LOCALFOLD_CHECK_FLASH=<calls>: the first calls recomputed on the host in double, and the difference printed
  static int checks = getenv("LOCALFOLD_CHECK_FLASH") ? atoi(getenv("LOCALFOLD_CHECK_FLASH")) : 0;
  struct Check {
    bool on; size_t qn, bn, mn, on_;
    std::vector<__half> q, bb, o; std::vector<float> mk, qb;
  } ck{checks-- > 0};
  if (ck.on) {
    CK(cudaDeviceSynchronize());
    ck.qn = (rows - 1) * rowStride + (size_t)(n - 1) * posStride + 4 * W;
    ck.q.resize(ck.qn); CK(cudaMemcpy(ck.q.data(), qkvg, ck.qn * 2, cudaMemcpyDeviceToHost));
    if (bias) { ck.bn = (size_t)heads * n * biasStride; ck.bb.resize(ck.bn); CK(cudaMemcpy(ck.bb.data(), bias, ck.bn * 2, cudaMemcpyDeviceToHost)); }
    if (mask) { ck.mk.resize((size_t)n * n); CK(cudaMemcpy(ck.mk.data(), mask, (size_t)n * n * 4, cudaMemcpyDeviceToHost)); }
    if (qBias) { ck.qb.resize(W); CK(cudaMemcpy(ck.qb.data(), qBias, W * 4, cudaMemcpyDeviceToHost)); }
  }
  if (bias && mask) flashGridMetal<D, true, false><<<grid, 128, 0, STREAM>>>(qkvg, bias, biasStride, mask, out, n, heads, r0, tr, scale, qBias, rowStride, posStride, outRowStride, outPosStride, (int)rows);
  else if (bias) flashGridMetal<D, false, false><<<grid, 128, 0, STREAM>>>(qkvg, bias, biasStride, mask, out, n, heads, r0, tr, scale, qBias, rowStride, posStride, outRowStride, outPosStride, (int)rows);
  else if (mask) flashGridMetal<D, true, true><<<grid, 128, 0, STREAM>>>(qkvg, bias, biasStride, mask, out, n, heads, r0, tr, scale, qBias, rowStride, posStride, outRowStride, outPosStride, (int)rows);
  else flashGridMetal<D, false, true><<<grid, 128, 0, STREAM>>>(qkvg, bias, biasStride, mask, out, n, heads, r0, tr, scale, qBias, rowStride, posStride, outRowStride, outPosStride, (int)rows);
  if (ck.on) {
    size_t on = (rows - 1) * outRowStride + (size_t)(n - 1) * outPosStride + W;
    ck.o.resize(on); CK(cudaMemcpy(ck.o.data(), out, on * 2, cudaMemcpyDeviceToHost));
    double err = 0, nrm = 0; int bad = 0;
    for (size_t rl = 0; rl < rows; rl += std::max<size_t>(1, rows / 7))
      for (int h = 0; h < heads; ++h)
        for (int i = 0; i < n; i += std::max(1, n / 13)) {
          const __half* base = ck.q.data() + rl * rowStride + h * D;
          std::vector<double> lg(n), o(D, 0.0);
          double mx = -1e300;
          for (int j = 0; j < n; ++j) {
            double s = 0;
            for (int e = 0; e < D; ++e) {
              double qv = (double)(float)base[(size_t)i * posStride + e] + (qBias ? ck.qb[h * D + e] : 0.0);
              s += qv * scale * (double)(float)base[(size_t)j * posStride + W + e];
            }
            if (bias) s += (double)(float)ck.bb[((size_t)h * n + i) * biasStride + j] / 1.4426950408889634;
            if (mask && !(ck.mk[tr ? ((size_t)j * n + r0 + rl) : ((r0 + rl) * n + j)] > 0.f)) s -= 1e9;
            lg[j] = s; mx = std::max(mx, s);
          }
          double l = 0;
          for (int j = 0; j < n; ++j) { double p = std::exp(lg[j] - mx); l += p;
            for (int e = 0; e < D; ++e) o[e] += p * (double)(float)base[(size_t)j * posStride + 2 * W + e]; }
          for (int e = 0; e < D; ++e) {
            double g = (double)(float)base[(size_t)i * posStride + 3 * W + e];
            double want = o[e] / l / (1 + std::exp(-g));
            double got = (double)(float)ck.o[rl * outRowStride + (size_t)i * outPosStride + h * D + e];
            err += (got - want) * (got - want); nrm += want * want; if (!std::isfinite(got)) ++bad;
          }
        }
    printf("  flashGridMetal<%d> n %d heads %d rows %zu bias %d mask %d tr %d strided %d: relRMS %.3e%s\n", D, n, heads, rows,
           bias != nullptr, mask != nullptr, (int)tr, posStride != 4 * W, std::sqrt(err / std::max(nrm, 1e-300)), bad ? " NONFINITE" : "");
  }
}
inline void flashGridMetalAny(int D, const half* qkvg, const half* bias, int biasStride, const float* mask, half* out, int n,
                              int heads, size_t r0, size_t rows, bool tr, float scale, const float* qBias,
                              size_t rowStride = 0, size_t posStride = 0, size_t outRowStride = 0, size_t outPosStride = 0) {
  switch (D) {
    case 16: flashGridMetalRun<16>(qkvg, bias, biasStride, mask, out, n, heads, r0, rows, tr, scale, qBias, rowStride, posStride, outRowStride, outPosStride); break;
    case 24: flashGridMetalRun<24>(qkvg, bias, biasStride, mask, out, n, heads, r0, rows, tr, scale, qBias, rowStride, posStride, outRowStride, outPosStride); break;
    case 32: flashGridMetalRun<32>(qkvg, bias, biasStride, mask, out, n, heads, r0, rows, tr, scale, qBias, rowStride, posStride, outRowStride, outPosStride); break;
    case 48: flashGridMetalRun<48>(qkvg, bias, biasStride, mask, out, n, heads, r0, rows, tr, scale, qBias, rowStride, posStride, outRowStride, outPosStride); break;
    case 64: flashGridMetalRun<64>(qkvg, bias, biasStride, mask, out, n, heads, r0, rows, tr, scale, qBias, rowStride, posStride, outRowStride, outPosStride); break;
    default: fprintf(stderr, "flashGridMetal: no kernel for head width %d\n", D); exit(1);
  }
}

@@@ end
