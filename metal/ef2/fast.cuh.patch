# The unfused triangle (the path Metal takes): the projection's GEMM gates in its epilogue and writes a and b channel-major
# itself (lf::gemmTriGate), and the gating linear's GEMM adds its gated product into the pair (lf::gemmGatedAdd) - as
# metal/af3/pairtrack.cuh.patch takes AF3's - where the port writes a 5C-wide projection, splits it in triSplitHK and adds
# in gateMulAddHK. The output projection is f16 for it. LOCALFOLD_UNFUSED_TRIGATE=1 is the control.
@@@ old
inline void triangleFusedIn(float* pair, const float* mask, int L, int C, const std::string& Tn, bool outgoing);
@@@ new
// (Metal) the triangle's projection and gate as one weight for lf::gemmTriGate: channel c's (pa, pb, ga, gb) at columns
// 4c..4c+3 - ESMFold2 interleaves a and b by channel as AF3 does - built once, a derived weight
__global__ void triGateEfK(const half* proj, const half* gate, half* out, int rows, int C) {
  size_t t = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
  if (t >= (size_t)rows * 4 * C) return;
  unsigned r = (unsigned)(t / (4u * C)), col = (unsigned)(t - (size_t)r * 4u * C), c = col / 4, k = col % 4;
  out[t] = k < 2 ? proj[(size_t)r * 2 * C + 2 * c + k] : gate[(size_t)r * 2 * C + 2 * c + k - 2];
}
inline const half* triGateEf(const std::string& Tn, int C) {
  static std::map<std::string, half*> made;
  static bool hooked = false;
  if (!hooked) { FORGET_HOOKS.push_back([] { for (auto& kv : made) CK(cudaFree(kv.second)); made.clear(); }); hooked = true; }
  auto it = made.find(Tn);
  if (it != made.end()) return it->second;
  half* out = dallocT<half>((size_t)C * 4 * C);
  triGateEfK<<<blocks((size_t)C * 4 * C), 256, 0, STREAM>>>(Fh(Tn + "projection"), Fh(Tn + "gate"), out, C, C);
  return made[Tn] = out;
}
inline void triangleFusedIn(float* pair, const float* mask, int L, int C, const std::string& Tn, bool outgoing);
