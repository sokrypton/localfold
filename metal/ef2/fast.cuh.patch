__global__ void interleaveHalvesEfK(const half* w, half* out, int rows, int I) {
  size_t t = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
  if (t >= (size_t)rows * 2 * I) return;
  unsigned r = (unsigned)(t / (2u * I)), c = (unsigned)(t - (size_t)r * 2u * I), k = c / 2;
  out[t] = w[(size_t)r * 2 * I + ((c & 1) ? I + k : k)];
}
// (a derived weight, forgotten with the others after a warm-up that ran while the weights were still arriving)
inline const half* swigluPairsEf(const std::string& name, int rows, int I) {
  static std::map<std::string, half*> made;
  static bool hooked = false;
  if (!hooked) { FORGET_HOOKS.push_back([] { for (auto& kv : made) CK(cudaFree(kv.second)); made.clear(); }); hooked = true; }
  auto it = made.find(name);
  if (it != made.end()) return it->second;
  half* out = dallocT<half>((size_t)rows * 2 * I);
  interleaveHalvesEfK<<<blocks((size_t)rows * 2 * I), 256, 0, STREAM>>>(Fh(name), out, rows, I);
  return made[name] = out;
}
