inline std::map<std::string, float*> REBUILT_F32;
inline void installMirrorRebuild() {
  // 🔴 A DERIVED WEIGHT: a rebuilt copy made during a warm-up that ran while the weights were still arriving (cuda/ef2)
  // is garbage, and kept it was the real fold's - 5CAJ through ESMFold2 at pLDDT 71.4 where it is 90.8. Forgotten with
  // the others (FORGET_HOOKS), and rebuilt from the finished mirror on its next read.
  static bool hooked = false;
  if (!hooked) {
    hooked = true;
    FORGET_HOOKS.push_back([] {
      for (auto& [k, f] : REBUILT_F32) { CK(cudaFree(f)); WF.erase(k); }
      REBUILT_F32.clear();
    });
  }
  DROPPED_F32 = [](const std::string& k) -> const float* {
    auto it = REBUILT_F32.find(k);
    if (it != REBUILT_F32.end()) return it->second;
    const half* h = Wh(k); size_t n = M.len(k);
    float* f = dallocT<float>(n);
    halfToFloatWK<<<blocks(n), 256, 0, STREAM>>>(h, f, n);
    if (getenv("LOCALFOLD_MEM_REBUILT")) fprintf(stderr, "  f32 rebuilt from f16: %s (%.1f MB)\n", k.c_str(), n * 4 / 1e6);
    return REBUILT_F32[k] = f;
  };
  RELEASE_REBUILT = [] {
    if (REBUILT_F32.empty()) return;
    CK(cudaDeviceSynchronize());
    for (auto& [k, f] : REBUILT_F32) { CK(cudaFree(f)); WF.erase(k); }
    REBUILT_F32.clear();
  };
}
inline size_t dropLargeFloatCopies(int seg, const std::function<bool(const std::string&)>& keepF32) {
  constexpr size_t DROP_MIN = 65536;
  std::set<std::string> groups;
  for (auto& [name, e] : M.index)
    if (e.seg == seg && e.kind == 't' && e.devOffset != Model::DROPPED && groups.insert(halfGroup(name)).second) Wh(name);
  if (groups.empty()) return 0;
  size_t freed = compactWeights(seg, [&](const std::string& n) {
    bool d = M.len(n) >= DROP_MIN && !keepF32(n);
    if (d && getenv("LOCALFOLD_MEM_DROPPED")) fprintf(stderr, "  f32 dropped: %s\n", n.c_str());
    return d;
  });
  installMirrorRebuild();
  return freed;
}
