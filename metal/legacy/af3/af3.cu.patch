# (Metal) the weights held once, as f16, where the CUDA port holds every tensor as f32 and its f16 mirror beside it
# (2.51 GB for AF3's 424 M parameters, of which the mirror is 0.85): every tensor of 64 K elements or more loses its
# f32 copy once the mirror is made. The few paths that read one of those as f32 (the diffusion conditioning's float
# GEMMs, concatenations built from parts) get a copy rebuilt from the mirror, once - f16's rounding on a weight that
# is int5 to begin with (metal/af3/common.cuh.patch, dropLargeFloatCopies). LOCALFOLD_KEEP_F32=1 is the control.
@@@ insert
inline size_t dropFloatCopies(int segs) {
  size_t freed = 0;
  // (not the input embedder's - z_init and the single from target_feat, a few MB: their f16 rounding took
  // IntelliFold-2's pLDDT down 0.8 on every seed while the structure did not move, bisected by prefix - and not the
  // confidence head's, which reads float throughout)
  for (int seg = 0; seg < segs; ++seg)
    freed += dropLargeFloatCopies(seg, [](const std::string& n) {
      return n.rfind("trunk.embedder.", 0) == 0 || n.rfind("confidence.", 0) == 0;
    });
  return freed;
}
@@@ end
@@@ old
  if (cublasWarm.joinable()) cublasWarm.join();
@@@ new
  if (cublasWarm.joinable()) cublasWarm.join();
  if (haveWeights && !getenv("LOCALFOLD_KEEP_F32")) {
    size_t freed = dropFloatCopies(esmSeg);
    if (getenv("LOCALFOLD_MEM")) fprintf(stderr, "  memory f32 weight copies dropped: %.2f GB\n", freed / 1e9);
  }
@@@ end
# (Metal) the trunk's working buffers given back when it is done, where the CUDA port keeps them for the next fold's
# trunk: they sat beside the diffusion's own (0.86 GB at 255 tokens), and memory is what a Mac is short of. The
# confidence head's pairformer takes the ones it uses again. LOCALFOLD_KEEP_SCRATCH=1 is the control.
@@@ old
    releaseConcatCopies(); memReport("trunk");
@@@ new
    releaseConcatCopies();
