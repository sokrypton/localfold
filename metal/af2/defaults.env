# Environment defaults for the Metal af2 port: the CUDA port's own switches. The fused grid attention (fusedtriangle.cuh's
# gridInK/gridOutK) is tensor-core code with no Metal version yet.
LOCALFOLD_AF2_UNFUSED_GRID=1
# AlphaFold 2 runs float in its reference: its all-half GEMMs keep a float accumulator (the AF3 lineage and ESMFold2
# accumulate those in half - metal/runtime/lfcuda.mm gemm; a no-alignment multimer moved 0.75 pLDDT on it)
LOCALFOLD_GEMM_FLOAT_ACC=1
