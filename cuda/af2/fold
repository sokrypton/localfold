#!/usr/bin/env bash
# The native AlphaFold 2 in one command:
#
#   cuda/af2/fold <out.pdb> --sequence=<SEQ>[:<SEQ>...] [--a3m=<path>] [--model=model_1_ptm] [-- <af2 flags>]
#   cuda/af2/fold 6mrr.pdb --sequence=GWSTELEKHREEL...
#   cuda/af2/fold 1brs.pdb --sequence=<A>:<B> --model=model_1_multimer_v3 --search
#   cuda/af2/fold 5caj.pdb --sequence=<SEQ> --template=5caj.pdb:A       (1brs: --template=1brs.pdb:A+D)
#
# A wrapper over the standalone binary, `cuda/af2/af2 --out=<out.pdb> <flags>` (cuda/featurise/standalone.h), which
# it builds if it is missing: --model is model_N_ptm or model_N_multimer_v3, N 1 to 5 (2-5 the page's deltas on
# model 1), its published bundle fetched once; the input featurised in the same process, the page's own features
# byte for byte; a searched alignment kept as <out>.a3m.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
[ $# -ge 1 ] || { sed -n '2,12p' "$0"; exit 1; }
out="$1"; shift
args=()
for a in "$@"; do [ "$a" = "--" ] || args+=("$a"); done
[ -x "$here/af2" ] || bash "$here/../build.sh" af2 >&2
exec "$here/af2" --out="$out" "${args[@]}"
