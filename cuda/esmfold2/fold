#!/usr/bin/env bash
# The native ESMFold2 (esmfold2-fast-600m) in one command:
#
#   cuda/esmfold2/fold <out.pdb> --sequence=<SEQ>[:<SEQ>...] [-- <esmfold2 flags>]
#   cuda/esmfold2/fold 6mrr.pdb --sequence=GWSTELEKHREEL...
#   cuda/esmfold2/fold cam.pdb --job=tools/fixtures/af3-jobs/calmodulin_4calcium.json --model=esmfold2-fast-300m
#
# A wrapper over the standalone binary, `cuda/esmfold2/esmfold2 --out=<out.pdb> <flags>` (cuda/featurise/standalone.h),
# which it builds if it is missing: --model=esmfold2-fast-600m (the default: the experimental tier the page ships),
# esmfold2-fast-300m (its 300M sibling), their published bundles fetched once - or one of the released models,
# esmfold2-fast and esmfold2 (with its MSA encoder), from their local exports (README.md, "The released models").
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
[ $# -ge 1 ] || { sed -n '2,11p' "$0"; exit 1; }
out="$1"; shift
args=()
for a in "$@"; do [ "$a" = "--" ] || args+=("$a"); done
[ -x "$here/esmfold2" ] || bash "$here/../build.sh" esmfold2 >&2
exec "$here/esmfold2" --out="$out" "${args[@]}"
