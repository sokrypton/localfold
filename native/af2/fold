#!/usr/bin/env bash
# The native AlphaFold 2 in one command:
#
#   native/af2/fold <out.pdb> --sequence=<SEQ>[:<SEQ>...] [--a3m=<path>] [--model=model_1_ptm] [-- <af2 flags>]
#   native/af2/fold 6mrr.pdb --sequence=GWSTELEKHREEL...
#   native/af2/fold 1brs.pdb --sequence=<A>:<B> --model=model_1_multimer_v3
#
# --model names a DeepMind parameter set (model_1_ptm .. model_5_ptm, model_1_multimer_v3 ..); its
# weights are exported once (native/af2/export_weights.py, af3-any-model's conversion) into
# native/af2/weights-<model>. Input flags (--sequence, --a3m, --recycles, --max-msa, --max-extra,
# --seed) go to export_input.mjs; flags after -- go to ./af2, which runs --fast.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
[ $# -ge 1 ] || { sed -n '2,13p' "$0"; exit 1; }
out="$1"; shift
inputs=(); flags=(); model=model_1_ptm
while [ $# -gt 0 ]; do
  if [ "$1" = "--" ]; then shift; flags=("$@"); break; fi
  case "$1" in --model=*) model="${1#--model=}" ;; *) inputs+=("$1") ;; esac
  shift
done
python="${AF2_PYTHON:-$HOME/.venv-lfjax/bin/python}"
reference="${AF2_REFERENCE:-/tmp/claude-1000/ref}"
if [ ! -x "$here/af2" ]; then
  (cd "$here" && nvcc -O3 -std=c++17 -arch=sm_80 --default-stream per-thread --use_fast_math src/af2.cu \
     -lcublas -lcublasLt -lcupti -o af2)
fi
weights="$here/weights-$model"
[ -f "$weights/model.idx" ] || "$python" "$here/export_weights.py" --model "$model" --reference "$reference" --out "$weights"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
node "$here/export_input.mjs" "$tmp" --weights="$weights" "${inputs[@]}"
"$here/af2" "$tmp" --weights="$weights" --fast --out="$out" "${flags[@]}"
